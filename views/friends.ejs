<%- include('partials/header') %>
<div class="friends-page">
  <h1>Friends</h1>
  <% if (error) { %><p class="flash error"><%= error %></p><% } %>
  <% if (notice) { %><p class="flash ok"><%= notice %></p><% } %>

  <form method="get" action="/friends" class="friend-add">
    <input name="q" value="<%= query %>" placeholder="Search for friends"
           autocomplete="off" autocapitalize="none" autocorrect="off" spellcheck="false" required>
    <button>Search</button>
  </form>

  <form method="post" action="/friends/request" class="friend-add">
    <input name="username" placeholder="Add by exact username"
           autocomplete="off" autocapitalize="none" autocorrect="off" spellcheck="false" required>
    <button>Send request</button>
  </form>

  <% if (query) { %>
    <h2>Results for “<%= query %>”</h2>
    <% if (results.length === 0) { %>
      <p class="empty-inline">Nothing found. If you know their exact username, add them above.</p>
    <% } %>
    <div id="search-results">
    <% results.forEach(function (p) { %>
      <div class="friend-row">
        <% if (p.isFriend) { %>
          <a href="/u/<%= p.username %>"><strong>@<%= p.username %></strong></a>
          <span class="handle">friends</span>
        <% } else { %>
          <span><strong>@<%= p.username %></strong></span>
          <% if (p.incomingId) { %>
            <form method="post" action="/friends/accept" class="inline-form">
              <input type="hidden" name="request_id" value="<%= p.incomingId %>"><button>Accept</button>
            </form>
          <% } else if (p.requested) { %>
            <span class="handle">requested</span>
          <% } else { %>
            <form method="post" action="/friends/request" class="inline-form">
              <input type="hidden" name="username" value="<%= p.username %>"><button>Add</button>
            </form>
          <% } %>
        <% } %>
      </div>
    <% }) %>
    </div>
  <% } %>

  <% if (incoming.length) { %>
    <h2>Requests for you</h2>
    <% incoming.forEach(function (r) { %>
      <div class="friend-row">
        <span><strong><%= r.display_name %></strong> <span class="handle">@<%= r.username %></span></span>
        <span class="friend-actions">
          <form method="post" action="/friends/accept" class="inline-form">
            <input type="hidden" name="request_id" value="<%= r.id %>"><button>Accept</button>
          </form>
          <form method="post" action="/friends/decline" class="inline-form">
            <input type="hidden" name="request_id" value="<%= r.id %>"><button class="linklike">Decline</button>
          </form>
        </span>
      </div>
    <% }) %>
  <% } %>

  <% if (sent.length) { %>
    <h2>Sent requests</h2>
    <div id="sent-requests">
    <% sent.forEach(function (r) { %>
      <div class="friend-row">
        <span><strong>@<%= r.username %></strong></span>
        <form method="post" action="/friends/decline" class="inline-form">
          <input type="hidden" name="request_id" value="<%= r.id %>">
          <input type="hidden" name="unmatched" value="<%= r.unmatched ? '1' : '0' %>">
          <button class="linklike">Cancel</button>
        </form>
      </div>
    <% }) %>
    </div>
  <% } %>

  <h2>Your friends (<%= friends.length %>)</h2>
  <% if (friends.length === 0) { %>
    <p class="empty-inline">Ask your friends for their usernames and add them above.</p>
  <% } %>
  <% friends.forEach(function (f) { %>
    <div class="friend-row">
      <a href="/u/<%= f.username %>"><strong><%= f.display_name %></strong> <span class="handle">@<%= f.username %></span></a>
      <form method="post" action="/friends/remove" class="inline-form"
            onsubmit="return confirm('Remove @<%= f.username %> as a friend?')">
        <input type="hidden" name="user_id" value="<%= f.id %>"><button class="linklike danger">Remove</button>
      </form>
    </div>
  <% }) %>

</div>
<%- include('partials/footer') %>
