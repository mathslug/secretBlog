<%- include('partials/header') %>
<div class="auth-card">
  <h1>🐌 Whorl</h1>
  <p class="tagline">special secret blog for secret friends</p>
  <% if (error) { %><p class="flash error"><%= error %></p><% } %>
  <form method="post" action="/login">
    <label>Username <input name="username" autocomplete="username" autocapitalize="none" autocorrect="off" spellcheck="false" required></label>
    <label>Password <input name="password" type="password" autocomplete="current-password" required></label>
    <button>Log in</button>
  </form>
  <p class="auth-alt">New here? <a href="/signup">Sign up</a></p>
</div>
<%- include('partials/footer') %>
