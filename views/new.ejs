<%- include('partials/header') %>
<div class="composer">
  <h1>New post</h1>
  <% if (error) { %><p class="flash error"><%= error %></p><% } %>

  <% if (status.postedToday) { %>
    <div class="empty">
      <p>You already posted today. 🐌</p>
      <p>Come back tomorrow.</p>
    </div>
    <div id="install-nudge" class="install-nudge hidden">
      <p class="install-title">While you wait: put Slug Club on your home screen</p>
      <button type="button" id="install-btn" class="hidden">Add to home screen</button>
      <p id="install-ios" class="hint hidden">Open this site in Safari, tap the Share button (the square with the up arrow), then choose “Add to Home Screen”.</p>
      <p id="install-generic" class="hint hidden">Open your browser’s menu and choose “Add to Home Screen” (sometimes called “Install app”).</p>
    </div>
  <% } else { %>
    <p class="rule-note">
      <%= status.photosSinceEssay %> short post<%= status.photosSinceEssay === 1 ? '' : 's' %> since your last essay.
      Essays unlock at <%= status.essayAllowedAfterPhotos %>; after <%= status.essayRequiredAfterPhotos %> short posts your next post must be an essay.
    </p>

    <% if (status.canPhoto && status.canEssay) { %>
      <div class="tabs">
        <button type="button" class="tab active" data-tab="photo">Short post</button>
        <button type="button" class="tab" data-tab="essay">Essay</button>
      </div>
    <% } %>

    <% if (status.canPhoto) { %>
      <form method="post" action="/posts" enctype="multipart/form-data" id="photo-form"
            class="<%= status.canEssay && status.canPhoto ? '' : '' %>">
        <input type="hidden" name="type" value="photo">
        <label class="file-label">
          <input type="file" name="photo" id="photo-input" accept="image/*">
        </label>
        <div id="crop-wrap" class="hidden">
          <div id="crop-stage"><img id="crop-img" alt="" draggable="false"></div>
          <label class="zoom-label">Zoom
            <input type="range" id="zoom" min="1" max="3" step="0.01" value="1">
          </label>
          <p class="hint">Drag to reposition. This is the only editing there is.</p>
        </div>
        <input type="hidden" name="cropX"><input type="hidden" name="cropY"><input type="hidden" name="cropSize">
        <textarea name="caption" maxlength="<%= limits.caption %>" rows="3"
                  placeholder="Say something (<%= limits.caption %> characters max) — with a photo it's the caption, without one it stands alone" data-count="cap-count"></textarea>
        <div class="charcount"><span id="cap-count">0</span>/<%= limits.caption %></div>
        <button class="primary">Post</button>
      </form>
    <% } %>

    <% if (status.canEssay) { %>
      <form method="post" action="/posts" id="essay-form" class="<%= status.canPhoto ? 'hidden' : '' %>">
        <input type="hidden" name="type" value="essay">
        <textarea name="body" rows="18" minlength="<%= limits.essayMin %>" maxlength="<%= limits.essayMax %>" required
                  placeholder="Your essay (<%= limits.essayMin.toLocaleString() %>–<%= limits.essayMax.toLocaleString() %> characters)" data-count="essay-count"></textarea>
        <div class="charcount"><span id="essay-count">0</span>/<%= limits.essayMax.toLocaleString() %> (min <%= limits.essayMin.toLocaleString() %>)</div>
        <button class="primary">Post essay</button>
      </form>
    <% } %>
  <% } %>
</div>
<%- include('partials/footer') %>
<script src="/js/crop.js"></script>
