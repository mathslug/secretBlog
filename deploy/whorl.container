# Quadlet unit for whorl (rootless podman + systemd).
#
# Installed to ~/.config/containers/systemd/whorl.container on the host.
# systemd's podman-user-generator turns this into whorl.service at boot;
# there is no `podman generate systemd` step and no unit to regenerate when
# this file changes — `systemctl --user daemon-reload` is enough.
#
# Requires `loginctl enable-linger <user>` so it starts at boot without a login.

[Unit]
Description=whorl — one photo a day, friends only
Documentation=https://github.com/mathslug/secretBlog
After=network-online.target
Wants=network-online.target

[Container]
ContainerName=whorl
Image=localhost/whorl:latest

# Loopback only. The public path is the Cloudflare tunnel, which reaches this
# from the same host, so there is no reason to expose it on the LAN.
PublishPort=127.0.0.1:3000:3000

# %h is the owning user's home directory.
Volume=%h/data/whorl:/data

EnvironmentFile=%h/.config/whorl.env
Environment=NODE_ENV=production
Environment=PORT=3000
Environment=DATA_DIR=/data

# The Pi has 8GB; this is a blast-radius cap, not a tuning parameter. Requires
# the memory cgroup controller, which on Raspberry Pi OS means
# cgroup_enable=memory in /boot/firmware/cmdline.txt (the firmware injects
# cgroup_disable=memory by default).
#
# Passed through rather than set as a Quadlet key: podman 5.4's Quadlet has no
# `Memory=` key in [Container] and refuses to generate the unit if given one.
PodmanArgs=--memory=512m

# A script rather than an inline `node -e "…"`: Quadlet's parser does not
# survive nested quotes and silently truncates the command at the first inner
# quote, leaving the container permanently "unhealthy" with a shell syntax
# error while the app is fine. Verify with `podman inspect --format
# '{{.Config.Healthcheck.Test}}'` after any change here.
HealthCmd=node /app/healthcheck.js
HealthInterval=30s
HealthRetries=3
HealthStartPeriod=15s

[Service]
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
