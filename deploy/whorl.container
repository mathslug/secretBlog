# Quadlet unit for whorl (rootless podman + systemd).
#
# Installed to ~/.config/containers/systemd/whorl.container on the host, where
# systemd's podman-user-generator turns it into whorl.service. Changes here take
# effect on `systemctl --user daemon-reload`; there is no unit to regenerate.
#
# Starting at boot without a login needs `loginctl enable-linger <user>`.

[Unit]
Description=whorl — one photo a day, friends only
Documentation=https://github.com/mathslug/secretBlog
After=network-online.target
Wants=network-online.target

[Container]
ContainerName=whorl
Image=localhost/whorl:latest

# Loopback only: the Cloudflare tunnel reaches this from the same host, so the
# LAN needs no access to it.
PublishPort=127.0.0.1:3000:3000

# %h is the owning user's home directory.
Volume=%h/data/whorl:/data

EnvironmentFile=%h/.config/whorl.env
Environment=NODE_ENV=production
Environment=PORT=3000
Environment=DATA_DIR=/data

# The Pi has 8GB; this is a blast-radius cap, not a tuning parameter. Requires
# the memory cgroup controller, which on Raspberry Pi OS means
# cgroup_enable=memory in /boot/firmware/cmdline.txt (the firmware injects
# cgroup_disable=memory by default).
#
# Passed through rather than set as a Quadlet key: podman 5.4's Quadlet has no
# `Memory=` key in [Container] and refuses to generate the unit if given one.
PodmanArgs=--memory=512m

# Quadlet truncates a command at the first nested quote, so the check is a file
# rather than an inline `node -e "…"`. After changing this, confirm what the
# container actually received:
#
#     podman inspect --format '{{.Config.Healthcheck.Test}}' whorl
HealthCmd=node /app/healthcheck.js
HealthInterval=30s
HealthRetries=3
HealthStartPeriod=15s

[Service]
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
