[Unit]
Description=Slug Club
After=network.target

[Service]
Type=simple
User=slugclub
Group=slugclub
WorkingDirectory=/srv/app
EnvironmentFile=/etc/slugclub.env
ExecStart=/usr/bin/node src/server.js
Restart=always
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/srv/app-data

[Install]
WantedBy=multi-user.target
